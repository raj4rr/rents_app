public class SwitchExample1{
	static short s;
	static int   i;
	static long  L;
	public SwitchExample1(){
		public static void main(String args[]){
			switch(s)
				{
				case 0: System.out.println(s);
				break;
				case 1: System.out.println(s);
				break;
				case 2: System.out.println(s);
				break;
				case 3: System.out.println(s);
				break;
				}
			switch(i)
				{
				case 0: System.out.println(i);
				break;
				case 1: System.out.println(i);
				break;
				case 2: System.out.println(i);
				break;
				case 3: System.out.println(i);
				break;
				case 4: System.out.println(i);
				break;
				}
			switch(L)
				{ // EXPECT COMPILER ERROR
				case 0: System.out.println(i);
				break;
				case 1: System.out.println(i);
				break;
				case 2: System.out.println(i);
				break;
				case 3: System.out.println(i);
				break;
				case 4: System.out.println(i);
				break;
				}
  }
}
