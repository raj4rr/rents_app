<p class="MsoNormal" style="margin-right: -33.55pt" dir="ltr">
<font face="Verdana"><span lang="en-gb"><b>
<font size="2" color="#3399FF">Reading a file using C</font><font size="2" color="#000000"> </font></b></span>
</font></p>
	<p class="MsoNormal" style="margin-right: -33.55pt" dir="ltr">
	<font face="Verdana" size="2">
	<span lang="en-gb"><font color="#000000">Once The file has been opened for reading using fopen( ) function .</font></span><font color="#000000">the 
file&#8217;s contents are brought into memory and a pointer points to the very first 
character. To read the file&#8217;s contents from memory there exists a function 
called fgetc( ) . </font></font></p>
	<table border="1" width="66%">
		<tr>
			<td>

<PRE><font size="2" color="#008000" face="Verdana">/* 
 * program to read data form file
 */</font></PRE>
			<PRE>&nbsp;</PRE>
			<PRE><FONT FACE="Verdana"><FONT COLOR="#ff0000">#include</FONT><FONT COLOR="#000000">&lt;stdio.h&gt;</FONT>
<FONT COLOR="#0000ff">void</FONT><FONT COLOR="#000000"> main()</FONT>
<FONT COLOR="#000000">{</FONT>
	<FONT COLOR="#000000">FILE *fp1;</FONT>
	<FONT COLOR="#0000ff">char </FONT><FONT COLOR="#000000">a;</FONT>
	<FONT COLOR="#0000ff">if </FONT><FONT COLOR="#000000">((fp1=fopen(</FONT><FONT COLOR="#ff00ff">&quot;myfile.txt&quot;</FONT><FONT COLOR="#000000">,</FONT><FONT COLOR="#ff00ff">&quot;r&quot;</FONT><FONT COLOR="#000000">))==NULL)</FONT>
		<FONT COLOR="#000000">printf(</FONT><FONT COLOR="#ff00ff">&quot;this file does not exist\n&quot;</FONT><FONT COLOR="#000000">);</FONT>
	<FONT COLOR="#0000ff">else</FONT>
	<FONT COLOR="#000000">{</FONT>
		<FONT COLOR="#0000ff">while</FONT><FONT COLOR="#000000">((a==fgetc(fp1))!EOF)</FONT>
			<FONT COLOR="#000000">printf(</FONT><FONT COLOR="#ff00ff">&quot;%c&quot;</FONT><FONT COLOR="#000000">,a);</FONT>
	<FONT COLOR="#000000">}</FONT> <!--#include file="/common-files/ads6.shtml" -->
	<FONT COLOR="#000000">}</FONT></FONT></PRE>
			</td>
		</tr>
	</table>
<PRE><font size="2" color="#FF0000" face="Verdana">
